# --- Shopify (leave blank to run on the built-in mock catalogue) ---
# e.g. zenkaii.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront API public access token (Headless channel or custom app)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional: only list products from this collection, in its manual order
SHOPIFY_COLLECTION_HANDLE=
# Optional: defaults to 2026-07
SHOPIFY_API_VERSION=
# Optional: Admin API token with write_customers scope, for newsletter signups
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Site tweaks (replace the prototype's Tweaks panel) ---
# Full chaos | Maximal | Calm
NEXT_PUBLIC_MOTION_LEVEL=Full chaos
NEXT_PUBLIC_CURSOR_SPIRIT=true
NEXT_PUBLIC_PETAL_DENSITY=34
NEXT_PUBLIC_FREE_CARRIAGE_OVER=200
# Featured drop block
NEXT_PUBLIC_DROP_NUMBER=009
# ISO date the drop countdown runs to; blank = a rolling 13-day countdown
NEXT_PUBLIC_DROP_ENDS_AT=
NEXT_PUBLIC_DROP_RUN_SIZE=300
NEXT_PUBLIC_DROP_REMAINING=84
